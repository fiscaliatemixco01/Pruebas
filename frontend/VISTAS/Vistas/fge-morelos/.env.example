# URL base de tu API (backend Node/Express, etc.) que se conecta a Postgres.
VITE_API_URL=http://localhost:4000/api

# Ponlo en "true" para navegar todas las pantallas SIN backend ni Postgres:
# salta el login con un usuario falso y las pantallas que no tienen datos
# simplemente se muestran vacías. Déjalo en "false" (o bórralo) para usar
# el backend real.
VITE_DEMO_MODE=false
