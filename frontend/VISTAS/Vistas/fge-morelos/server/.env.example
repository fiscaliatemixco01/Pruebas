# Datos de conexión a TU Postgres local (los mismos que usas en psql/pgAdmin)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=fge_morelos

# Puerto donde corre esta API
PORT=4000

# URL del frontend (para permitir CORS con cookies de sesión)
FRONTEND_URL=http://localhost:5173

# Cualquier cadena aleatoria larga, usada para firmar la cookie de sesión
SESSION_SECRET=cambia-esto-por-algo-aleatorio
